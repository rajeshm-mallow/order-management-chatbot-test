{
  "botium": {
    "Capabilities": {
      "PROJECTNAME": "Strands Agents LLM Chatbot Test",
      "CONTAINERMODE": "simplerest",
      "WAITFORBOTTIMEOUT": 60000,
      "SIMPLEREST_TIMEOUT": 60000,
      "SIMPLEREST_START_HOOK": "./hooks/create-session-hook.js",
      "SIMPLEREST_URL": "{{#fnc.env}}CHATBOT_SERVER_URL{{/fnc.env}}/api/v1/chat",
      "SIMPLEREST_METHOD": "POST",
      "SIMPLEREST_BODY_TEMPLATE": {
        "query": "{{msg.messageText}}"
      },
      "SIMPLEREST_HEADERS_TEMPLATE": {
        "Content-Type": "application/json",
        "X-Session-Unique-Id": "{{context.sessionId}}",
        "client-uuid": "{{#fnc.env}}CLIENT_UUID{{/fnc.env}}",
        "Cookie": "{{#fnc.env}}COOKIE{{/fnc.env}}"
      },
      "SIMPLEREST_RESPONSE_JSONPATH": "$.message",
      "ASSERTERS": [
        {
          "ref": "LLM_BASED_ASSERTER",
          "src": "./asserters/LLMBasedAsserter.js",
          "global": true,
          "args": {
            "mode": "score",
            "passing_score": 80
          }
        }
      ]
    }
  }
}