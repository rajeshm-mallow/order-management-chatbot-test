{
  "dependencies": {
    "@huggingface/inference": "^4.11.0",
    "@xenova/transformers": "^2.17.2",
    "botium-cli": "^1.1.0",
    "botium-crawler": "^0.0.25",
    "compute-cosine-similarity": "^1.1.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "botium-bindings": "^2.1.14",
    "botium-connector-echo": "latest",
    "botium-core": "^1.13.0",
    "mocha": "^11.7.2"
  },
  "botium": {
    "convodirs": [
      "spec/convo"
    ],
    "expandConvos": true,
    "expandUtterancesToConvos": false,
    "expandScriptingMemoryToConvos": false
  },
  "scripts": {
    "mocha": "mocha spec",
    "crawl": "rm -rf crawler-result && botium-crawler run",
    "install-all": "npm install",
    "run-tests": "botium-cli run --convos ./tests/wisk_owasp_convos --output ./reports/botium-results.json --format json",
    "run-crawler": "node ./crawlers/crawler-config.js",
    "generate-dataset": "python3 ./scripts/generate_dataset.py",
    "build-bundle": "node ./scripts/build_test_bundle.js",
    "smoke": "botium-cli run --convos ./tests/secure_examples --output ./reports/smoke.json --format json",
    "report-html": "botium-cli report html --input ./reports/botium-results.json --output ./reports/html-report"
  }
}
